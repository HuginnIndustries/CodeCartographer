{
  "name": "codecartographer-pi",
  "version": "0.12.11",
  "mcpName": "io.github.HuginnIndustries/codecartographer",
  "description": "Evidence-backed reverse engineering and human-gated software planning for Pi and MCP coding agents.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "codecartographer",
    "reverse-engineering",
    "llm",
    "mcp",
    "software-planning",
    "code-analysis",
    "synthesis"
  ],
  "license": "MIT",
  "author": "James Sesler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuginnIndustries/CodeCartographer.git"
  },
  "bugs": {
    "url": "https://github.com/HuginnIndustries/CodeCartographer/issues"
  },
  "homepage": "https://github.com/HuginnIndustries/CodeCartographer#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    ".codecarto/**/*",
    "dist/**/*",
    "assets/logo.svg",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "codecarto-mcp": "dist/mcp-server/bin.mjs"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "smoke": "node scripts/smoke-mcp.mjs",
    "demo:synthesis": "npm run build && node scripts/create-synthesis-demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./dist/extensions"
    ]
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
