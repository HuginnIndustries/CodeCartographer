{
  "permissions": {
    "deny": [
      "Write(./.codecarto/engineering/**)",
      "Edit(./.codecarto/engineering/**)",
      "Write($SPIKE_ROOT/hooks/**)",
      "Edit($SPIKE_ROOT/hooks/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyWrite": [
        "$SPIKE_ROOT/project/.codecarto/engineering",
        "$SPIKE_ROOT/hooks",
        "$SPIKE_ROOT/settings-E5.json"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$SPIKE_ROOT/hooks/observe.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$SPIKE_ROOT/hooks/observe.sh"
          }
        ]
      }
    ]
  }
}
